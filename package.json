        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.1.11"
    },
    "scripts": {
        "gql:cp_schema": "cp ../arbeidsgiver-notifikasjon-produsent-api/app/src/main/resources/bruker.graphql ./bruker.graphql",
        "gql:generate": "graphql-codegen",
        "clean": "rm -rf ./build/* && mkdir -p ./build",
        "compile": "tsc --project tsconfig.build.json",
        "build:demo": "vite build --mode demo",
        "build:production": "vite build --mode production",
        "build": "npm run clean && npm run compile && npx msw init ./public --save && npm-run-all --parallel build:*",
        "dev": "vite --mode=demo --base=/min-side-arbeidsgiver/",
        "lint": "eslint .",
        "test": "vitest run"
    },
    "lint-staged": {
        "*": "prettier --write"
    },
    "msw": {
        "workerDirectory": "public"
    }
}
